## Required

# LLM API keys
# Only required if you plan to use OpenRouter-hosted models. If you are
# running everything locally through Ollama, this can be left blank.
OPENROUTER_API_KEY=

# Optional: Azure-hosted models. Define deployments to expose them in the
# model picker and route through LiteLLM wildcards.
# - Azure OpenAI-compatible ids use `azure/<deployment>`
# - Azure AI Foundry/Inference ids use `azure_ai/<deployment>`
AZURE_OPENAI_API_BASE=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENTS=

AZURE_AI_API_BASE=
AZURE_AI_API_KEY=
AZURE_AI_API_VERSION=2024-05-01-preview
AZURE_AI_DEPLOYMENTS=

# Gemini CLI -> LiteLLM proxy -> OpenRouter
GOOGLE_GEMINI_BASE_URL=http://localhost:4000
GEMINI_API_KEY=sk-litellm-local

# Optional: comma-separated frontend origins allowed by backend CORS.
# Defaults include localhost/127.0.0.1 on ports 3000 and 3001.
#CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: public URL where the frontend is reachable (used by the frontend
# to expose a canonical URL and by startup scripts for the browser-open URL).
# Example: FRONTEND_URL=https://my.domain.example/kady
FRONTEND_URL=

# Optional: path prefix when serving the frontend behind a reverse proxy.
# Example: FRONTEND_URL_PREFIX=/kady
# If omitted, the prefix is inferred from FRONTEND_URL's path.
FRONTEND_URL_PREFIX=

# Optional: disable Next.js anonymous telemetry (1=disabled, 0=enabled).
NEXT_TELEMETRY_DISABLED=1

# Optional: use polling-based file watching for Next.js dev server.
# Helpful on systems where inotify/watch descriptors are limited (EMFILE).
WATCHPACK_POLLING=true
WATCHPACK_POLLING_INTERVAL=1000

# Optional: hard cap (seconds) for MCP tool discovery per server.
# Set to 0 to disable the guard.
KADY_MCP_GET_TOOLS_TIMEOUT=8

# Frontend model visibility flags (set to 0 to hide in picker)
NEXT_PUBLIC_ENABLE_OPENROUTER_MODELS=1
NEXT_PUBLIC_ENABLE_OLLAMA_MODELS=1

# LLMs
DEFAULT_AGENT_MODEL="openrouter/anthropic/claude-opus-4.7"
# Default model for the Gemini CLI expert subprocess (delegate_task). Any
# OpenRouter, Ollama, gemini-*, azure/*, or azure_ai/* id works; routes through the LiteLLM
# proxy. Leave blank to use the built-in recommended default
# (openrouter/google/gemini-3.1-pro-preview) — Gemini 3.1 Pro's native tool
# calling and 1M-token context suit the CLI expert better than the
# orchestrator's Claude Opus default.
DEFAULT_EXPERT_MODEL="openrouter/google/gemini-3.1-pro-preview"


## Optional: local Ollama server

# Host for a running `ollama serve`. Models pulled into Ollama show up
# automatically in the model dropdown and route through the LiteLLM
# proxy's `ollama/*` wildcard entry (see litellm_config.yaml).
OLLAMA_BASE_URL=http://localhost:11434


## Highly Recommended (Delete if not needed and filled in correctly)

# Exa Search (get your key at https://dashboard.exa.ai/api-keys)
EXA_API_KEY=

# Parallel Search
PARALLEL_API_KEY=

# Paperclip literature, regulatory, and clinical-trial MCP
PAPERCLIP_API_KEY=

# Modal
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=


